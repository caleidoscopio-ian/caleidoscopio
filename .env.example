# Caleidoscópio Educacional - Configurações de Ambiente

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/caleidoscopio?schema=public"

# Sistema Manager (Sistema 1) - URL da API central
NEXT_PUBLIC_MANAGER_API_URL="http://localhost:3000"

# Configurações de desenvolvimento
NODE_ENV="development"

# Opcional: Configurações de CORS para desenvolvimento
NEXT_PUBLIC_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"